# Copy to .env in the repo root (never commit .env).
# Cursor / VS Code launch configs load this via envFile.

# TopstepX / ProjectX (required for live bars)
PROJECTX_USERNAME=
PROJECTX_API_KEY=
# Optional. Default is https://api.topstepx.com/api
# PROJECTX_BASE_URL=https://api.topstepx.com/api

# Slack incoming webhook (required for channel alerts)
# Create at https://api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX
# SIGNAL_WEBHOOK_URL is also accepted (same thing, either name is enough)
