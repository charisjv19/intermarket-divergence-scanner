{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Live v8.7",
      "type": "debugpy",
      "request": "launch",
      "module": "live.v87",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Live v8.8 OOS",
      "type": "debugpy",
      "request": "launch",
      "module": "live.v88",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Live v8.10 dual-confirm",
      "type": "debugpy",
      "request": "launch",
      "module": "live.v810",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Test Slack webhook (v8.7)",
      "type": "debugpy",
      "request": "launch",
      "module": "live.v87",
      "args": ["--test-webhook"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Test Slack webhook (v8.8 OOS)",
      "type": "debugpy",
      "request": "launch",
      "module": "live.v88",
      "args": ["--test-webhook"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Both live scanners",
      "configurations": ["Live v8.7", "Live v8.8 OOS"],
      "stopAll": true
    },
    {
      "name": "v8.7 + v8.8 OOS + v8.10",
      "configurations": ["Live v8.7", "Live v8.8 OOS", "Live v8.10 dual-confirm"],
      "stopAll": true
    }
  ]
}
