//@version=6
indicator("SMT Macro Bias Background", overlay=true, max_bars_back=500)

// ── SETTINGS ─────────────────────────────────────────────────────────────────
// "5" and "15" are the TradingView timeframe strings for 5-minute and 15-minute.
biasTf          = input.string("15", "Bias Timeframe", options=["5", "15"], tooltip="Structural bias is calculated on this timeframe. The chart must be this timeframe, or a lower timeframe that divides it evenly (1m or 5m under 15m; 1m under 5m).")
bgOpacity       = input.int(88, "Background Opacity (0=solid, 100=invisible)", minval=0, maxval=100)
slowThreshold   = input.float(0.80, "Slowing Threshold (default 0.80 = 80%)", minval=0.1, maxval=1.0, step=0.01)
minLegs         = input.int(3, "Min Legs for Momentum Assessment", minval=2, maxval=6)
lookbackBars15m = input.int(144, "15m Lookback Bars (144 = 36 hours)", minval=20, maxval=500)

// ── COLORS ───────────────────────────────────────────────────────────────────
colorStrongBull  = color.new(color.green,  bgOpacity)
colorBullSlowing = color.new(#90EE90,      bgOpacity)   // light green
colorStrongBear  = color.new(color.red,    bgOpacity)
colorBearSlowing = color.new(#FFB3B3,      bgOpacity)   // light red
colorTransitory  = color.new(color.yellow, bgOpacity)
colorNone        = color.new(color.white,  100)         // fully transparent

// ── TIMEFRAME GUARD ──────────────────────────────────────────────────────────
// Swing tests have to land on whole bias-timeframe bars. A higher chart, or a
// chart that does not divide the bias timeframe, cannot supply those bars.
chartSeconds = timeframe.in_seconds()
biasSeconds  = timeframe.in_seconds(biasTf)
sameTf       = chartSeconds == biasSeconds

if not timeframe.isintraday or chartSeconds == 0
    runtime.error("SMT Macro Bias Background runs on an intraday chart (1m, 5m, or 15m).")
else if chartSeconds > biasSeconds
    runtime.error("Bias Timeframe is " + biasTf + "m, but this chart is higher. Use a " + biasTf + "m chart or lower, or set Bias Timeframe to 15.")
else if biasSeconds % chartSeconds != 0
    runtime.error("The chart timeframe must divide the " + biasTf + "m bias timeframe evenly.")

// ── SWING DETECTION ──────────────────────────────────────────────────────────
// Same 4-bar test as swing_marker_detection.pine:
// the swing is at bar[1] and is confirmed when bar[0] closes.
// isSwingHigh = high[1] > high[2] and high[1] > high[3] and high[1] > high[0]
f_swings() =>
    isSwingHigh = high[1] > high[2] and high[1] > high[3] and high[1] > high[0]
    isSwingLow  = low[1] < low[2] and low[1] < low[3] and low[1] < low[0]
    sh = isSwingHigh ? high[1] : float(na)
    sl = isSwingLow  ? low[1]  : float(na)
    [sh, sl]

// One completed bias bar earlier. Offsets are literals so they stay const.
// Used only inside request.security, where [1] is a bias-timeframe bar.
f_swingsConfirmed() =>
    isSwingHigh = high[2] > high[3] and high[2] > high[4] and high[2] > high[1]
    isSwingLow  = low[2] < low[3] and low[2] < low[4] and low[2] < low[1]
    sh = isSwingHigh ? high[2] : float(na)
    sl = isSwingLow  ? low[2]  : float(na)
    [sh, sl]

// Chart matches the selected bias timeframe: read that chart's bars.
// On a 15m chart with Bias Timeframe set to 15, this is the same 4-bar test
// the previous script ran. The 5m setting uses that same test on 5m bars.
[shChart, slChart] = f_swings()

// Chart is lower than the bias timeframe (for example 5m chart, 15m bias).
// lookahead_on plus the one-bar offset returns the last CLOSED bias bar, so
// historical bars and the realtime bar see the same confirmed swing.
[shHtf, slHtf] = request.security(syminfo.tickerid, biasTf, f_swingsConfirmed(), lookahead=barmerge.lookahead_on)

swingHighPrice = sameTf ? shChart : shHtf
swingLowPrice  = sameTf ? slChart : slHtf

// ── ROLLING SWING ARRAYS ─────────────────────────────────────────────────────
// Store the last 6 confirmed swing highs and lows for sequence analysis.
// timeframe.change is true once per bias bar: every chart bar when the chart
// matches, or the first chart bar of each 5m/15m period when the chart is lower.
var float[] swingHighs = array.new_float(0)
var float[] swingLows  = array.new_float(0)

if timeframe.change(biasTf)
    if not na(swingHighPrice)
        array.push(swingHighs, swingHighPrice)
        if array.size(swingHighs) > 6
            array.shift(swingHighs)

    if not na(swingLowPrice)
        array.push(swingLows, swingLowPrice)
        if array.size(swingLows) > 6
            array.shift(swingLows)

// ── SEQUENCE ANALYSIS ─────────────────────────────────────────────────────────
// Look at last 4 swing highs and lows to count HH/LH and HL/LL
f_sequence(arr) =>
    sz = array.size(arr)
    hh = 0
    lh = 0
    if sz >= 2
        // use last 4 (or however many we have)
        start = math.max(0, sz - 4)
        for i = start + 1 to sz - 1
            if array.get(arr, i) > array.get(arr, i - 1)
                hh += 1
            else if array.get(arr, i) < array.get(arr, i - 1)
                lh += 1
    [hh, lh]

[hhCount, lhCount] = f_sequence(swingHighs)
[hlCount, llCount] = f_sequence(swingLows)

bullScore = hhCount + hlCount
bearScore = lhCount + llCount

// Determine structure
// Requires at least one HH AND one HL for bullish, one LH AND one LL for bearish
isBullish     = bullScore > bearScore and hhCount > 0 and hlCount > 0
isBearish     = bearScore > bullScore and lhCount > 0 and llCount > 0
isTransitory  = not isBullish and not isBearish

// ── MOMENTUM (LEG SIZE) ANALYSIS ─────────────────────────────────────────────
// Measure impulse leg sizes and compare last two
f_legs(arr, direction) =>
    // direction: 1 = bullish (measure SH-to-SH gains), -1 = bearish (SL-to-SL drops)
    sz    = array.size(arr)
    leg1  = float(na)   // second-to-last leg
    leg2  = float(na)   // most recent leg
    if sz >= minLegs
        start = math.max(0, sz - (minLegs + 1))
        for i = start + 1 to sz - 1
            curr = array.get(arr, i)
            prev = array.get(arr, i - 1)
            legSize = direction == 1 ? curr - prev : prev - curr
            if legSize > 0
                leg1 := leg2
                leg2 := legSize
    [leg1, leg2]

isSlowing = false
if isBullish
    [l1, l2] = f_legs(swingHighs, 1)
    if not na(l1) and not na(l2) and l1 > 0
        ratio = l2 / l1
        isSlowing := ratio < slowThreshold

if isBearish
    [l1, l2] = f_legs(swingLows, -1)
    if not na(l1) and not na(l2) and l1 > 0
        ratio = l2 / l1
        isSlowing := ratio < slowThreshold

// ── FINAL BIAS STATE ─────────────────────────────────────────────────────────
biasColor =
  isBullish  and not isSlowing ? colorStrongBull  :
  isBullish  and isSlowing     ? colorBullSlowing :
  isBearish  and not isSlowing ? colorStrongBear  :
  isBearish  and isSlowing     ? colorBearSlowing :
  isTransitory                 ? colorTransitory  :
  colorNone

bgcolor(biasColor)

// ── BIAS LABEL (top right of chart) ──────────────────────────────────────────
tfTag = biasTf + "m"

biasText =
  isBullish  and not isSlowing ? "STRONGLY BULLISH"  :
  isBullish  and isSlowing     ? "BULLISH — SLOWING" :
  isBearish  and not isSlowing ? "STRONGLY BEARISH"  :
  isBearish  and isSlowing     ? "BEARISH — SLOWING" :
  isTransitory                 ? "TRANSITIONAL"      :
  "UNCLEAR"

labelColor =
  isBullish  and not isSlowing ? color.green  :
  isBullish  and isSlowing     ? #90EE90      :
  isBearish  and not isSlowing ? color.red    :
  isBearish  and isSlowing     ? #FFB3B3      :
  isTransitory                 ? color.yellow :
  color.gray

// Only draw label on the most recent bar to avoid clutter.
labelText = tfTag + " | " + biasText
if barstate.islast
    label.new(bar_index, high * 1.001, labelText, style = label.style_label_down, color = labelColor, textcolor = color.white, size = size.normal)

// ── DEBUG TABLE (optional — shows swing counts) ───────────────────────────────
showDebug = input.bool(false, "Show Debug Table")

if showDebug and barstate.islast
    var table t = table.new(position.top_left, 2, 7, bgcolor=color.new(color.black, 70), border_width=1)
    table.cell(t, 0, 0, "Metric",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "Value",      text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "Timeframe",  text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, tfTag,        text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "HH count",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(hhCount), text_color=color.lime,  text_size=size.small)
    table.cell(t, 0, 3, "LH count",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(lhCount), text_color=color.red,   text_size=size.small)
    table.cell(t, 0, 4, "HL count",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(hlCount), text_color=color.lime,  text_size=size.small)
    table.cell(t, 0, 5, "LL count",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(llCount), text_color=color.red,   text_size=size.small)
    table.cell(t, 0, 6, "Slowing",    text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(isSlowing), text_color=color.yellow, text_size=size.small)
